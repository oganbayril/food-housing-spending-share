# Static site: food-housing-spending-share.
# Installed as /etc/caddy/sites-enabled/food-housing.conf, with the site address
# below set to the real DuckDNS hostname (see deploy/PLAN.md).
# Caddy obtains and renews the TLS certificate itself.

FOODHOUSING_DOMAIN {
	root * /srv/food-housing-share
	file_server
	encode zstd gzip

	header {
		# HSTS for this host only: no includeSubDomains, no preload.
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		# The page carries the full Content-Security-Policy in a <meta> tag
		# (script hashes generated with the page). frame-ancestors only works
		# as a header, so it is set here; browsers enforce both policies.
		Content-Security-Policy "frame-ancestors 'none'"
		-Server
	}

	# The data file downloads instead of opening as text.
	@csv path /shares.csv
	header @csv Content-Disposition "attachment; filename=shares.csv"

	log {
		output file /var/log/caddy/food-housing.log
		format json
	}
}
